<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sm_print_cheque_wizard_form" model="ir.ui.view">
        <field name="name">sm.print.cheque.wizard.form</field>
        <field name="model">sm.print.cheque.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Cheque">
                <group>
                    <group>
                        <field name="payment_id"/>
                        <field name="cheque_format_id"/>
                    </group>
                    <group>
                        <field name="free_text"/>
                        <field name="partner_title"/>
                        <field name="cheque_no"/>
                        <field name="move_id" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_cheque" string="Print Cheque" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
